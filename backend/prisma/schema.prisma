generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Customer {
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  id         String      @id @default(uuid())
  email      String      @unique
  name       String
  password   String?
  stripeId   String?     @unique
  status     String      @default("PENDING")
  role       String      @default("CLIENT")
  services   String[]    @default([])
  createdAt  DateTime    @default(now())
  documents  Document[]
  disputes   Dispute[]
  taxProfile TaxProfile?
  businessTaxProfile BusinessTaxProfile?
  bookkeepingProfile BookkeepingProfile?
}

model Document {
  id          String           @id @default(uuid())
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fileName    String
  storagePath String           @unique
  mimeType    String
  sizeBytes   Int
  category    DocumentCategory @default(CREDIT_REPORT)
  createdAt   DateTime         @default(now())

  @@index([customerId])
}

enum DocumentCategory {
  CREDIT_REPORT
  TAX_DOCUMENT
  BOOKKEEPING
  TAX_PERSONAL
  TAX_BUSINESS
  OTHER
}

model Dispute {
  id            String   @id @default(uuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bureau        String
  accountName   String
  accountNumber String?
  status        String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([customerId])
}

model TaxProfile {
  id           String   @id @default(uuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  filingStatus String   @default("SINGLE")
  dependents   Int      @default(0)
  income       Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BusinessTaxProfile {
  id           String   @id @default(uuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  entityType   String   @default("S-CORP")
  ein          String?
  grossRevenue Float    @default(0)
  hasEmployees Boolean  @default(false)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime @default(now())
  
  sender     Customer @relation("SentMessages", fields: [senderId], references: [id])
  receiver   Customer @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model LetterTemplate {
  id        String   @id @default(uuid())
  bureau    String   @unique
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BookkeepingProfile {
  id           String   @id @default(cuid())
  customerId   String   @unique
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  businessName String   @default("")
  period       String   @default("")
  revenue      Float    @default(0)
  expenses     Float    @default(0)
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
